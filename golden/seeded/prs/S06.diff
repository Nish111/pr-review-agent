+def todays_notes(conn: sqlite3.Connection, user_id: int) -> list[dict]:
+    """Notes created today."""
+    today = date.today().isoformat()
+    rows = conn.execute(
+        "SELECT id, title, created_at FROM notes WHERE user_id = ? AND created_at LIKE ?",
+        (user_id, f"{today}%"),
+    ).fetchall()
+    return [dict(r) for r in rows]
